import SigGolf

namespace SigGolf.Challenge

noncomputable def submission : SigGolf.Submission := sorry

theorem signature_bytes : submission.sizes.signature = {{S}} := sorry

theorem witness_bytes : submission.sizes.witness = {{W}} := sorry

theorem cache_bytes : submission.sizes.cache = {{K}} := sorry

theorem layout_offsets : submission.layout =
  { message := {{MESSAGE}}, secretKey := {{SECRET_KEY}}, publicKey := {{PUBLIC_KEY}},
    cache := {{CACHE}}, signature := {{SIGNATURE}}, witness := {{WITNESS}} } := sorry

-- On `full`, `SigGolf.Certificate submission C`; on the hardware tracks,
-- `(SigGolf.Device.rules device hash).Certificate submission C`.
theorem certificate : {{CERTIFICATE}} := sorry

end SigGolf.Challenge
